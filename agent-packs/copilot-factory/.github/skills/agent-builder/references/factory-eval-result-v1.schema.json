{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory.eval-result/v1",
  "title": "Copilot Factory eval result v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "session_id",
    "pack",
    "eval_run_index",
    "selector",
    "report_path",
    "exit_code",
    "totals",
    "wall_clock_seconds",
    "failures"
  ],
  "properties": {
    "schema_version": { "const": "factory.eval-result/v1" },
    "session_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{8}$"
    },
    "pack": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "eval_run_index": { "type": "integer", "minimum": 1 },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^(?:all|evals/packs/[a-z0-9][a-z0-9-]*/(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*)$"
        }
      }
    },
    "report_path": { "type": ["string", "null"] },
    "resolved_model": { "type": ["string", "null"] },
    "exit_code": { "type": "integer" },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collected", "passed", "failed", "errored", "skipped"],
      "properties": {
        "collected": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "errored": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "wall_clock_seconds": { "type": "number", "minimum": 0 },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "failure_id",
          "case_id",
          "kind",
          "message_excerpt",
          "log_path",
          "test_path",
          "fixable_in"
        ],
        "properties": {
          "failure_id": { "type": "string", "minLength": 1 },
          "case_id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "message_excerpt": { "type": "string" },
          "log_path": { "type": ["string", "null"] },
          "test_path": { "type": ["string", "null"] },
          "fixable_in": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^agent-packs/[a-z0-9][a-z0-9-]*/\\.github/(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
            }
          }
        }
      }
    }
  }
}
