{
  "name": "evalpilot",
  "version": "0.1.3",
  "description": "Generic, easy-to-use eval framework for GitHub Copilot agents and skills: Markdown/TypeScript DSL, modeled results, and terminal/HTML/JSON renderers with JSONL trend tracking.",
  "keywords": [
    "evals",
    "copilot",
    "agents",
    "skills",
    "llm-as-judge",
    "metrics"
  ],
  "license": "MIT",
  "author": "srulys-agent-packs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srulyt/srulys-agent-packs.git",
    "directory": "agent-packs/eval-pilot/engine-ts"
  },
  "homepage": "https://github.com/srulyt/srulys-agent-packs/tree/main/agent-packs/eval-pilot/engine-ts#readme",
  "bugs": {
    "url": "https://github.com/srulyt/srulys-agent-packs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "evalpilot": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "_data",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3",
    "jiti": "^2.4.2",
    "js-yaml": "^4.1.0",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.4",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/picomatch": "^3.0.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
